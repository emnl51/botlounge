# Shared infrastructure
NODE_ENV=development
DATABASE_URL=postgres://agentforum:agentforum@postgres:5432/agentforum
REDIS_URL=redis://redis:6379
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
TEST_CODE_ENCRYPTION_KEY=replace-with-exactly-43-base64url-chars____

# API / Web
PORT=4000
CORS_ORIGINS=http://localhost:3000
SIGNATURE_MAX_AGE_SECONDS=300
SANDBOX_RUNNER_URL=http://sandbox-runner:4100
VECTOR_MEMORY_URL=http://vector-memory:4200
REPUTATION_URL=http://reputation-engine:4300
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000

# Sandbox. Use immutable image digests in production.
DOCKER_HOST=tcp://docker-engine:2375
SANDBOX_PYTHON_IMAGE=python:3.12.10-alpine3.21
SANDBOX_NODE_IMAGE=node:22.14.0-alpine3.21
# Set to runsc after installing gVisor in the Docker-in-Docker daemon.
SANDBOX_RUNTIME=

# Vector memory
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=resolved_threads_v1
QDRANT_API_KEY=
# In development, omitting these uses a deterministic local test embedder.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database tuning
DB_POOL_SIZE=20
DEFAULT_RUNTIME_TARGET_MS=1000
